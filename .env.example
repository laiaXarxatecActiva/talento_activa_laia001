# Copia este fichero a .env y rellena los valores reales:
#     cp .env.example .env
# .env NO se versiona (está en .gitignore). Nunca subas credenciales al repo.
#
# Mientras un valor conserve marcadores <así>, los tests de integración contra
# la BD se OMITEN (no fallan). En cuanto pongas valores reales, se ejecutan.

# ---------------------------------------------------------------------------
# Entorno
# ---------------------------------------------------------------------------
# development | test | production. En production la cookie `sesion` lleva Secure.
NODE_ENV=development

# ---------------------------------------------------------------------------
# Base de datos (Supabase / Postgres)  — OBLIGATORIA YA (src/model/db.ts)
# ---------------------------------------------------------------------------
# En Supabase: botón "Connect" (arriba del dashboard) → pestaña "Connection
# string" → "Transaction pooler". Cópiala tal cual y sustituye [YOUR-PASSWORD].
# El pooler (puerto 6543, PgBouncer en modo transacción) es el recomendado para
# el backend; el cliente usa prepare:false por ese motivo y exige TLS.
#
# Formato:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Ejemplo (valores inventados):
#   postgresql://postgres.abcdefghijklmnopqrst:MiClaveSuperSegura123@aws-0-eu-west-3.pooler.supabase.com:6543/postgres
#
# OJO: si la contraseña tiene caracteres especiales (@ : / # ? %), codifícalos
# en URL (p. ej. @ → %40) o usa una contraseña solo alfanumérica.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ---------------------------------------------------------------------------
# Opcional en desarrollo: si lo dejas con marcadores <...>, la app arranca igual
# (emails por consola; subida de miniaturas desactivada → 503).
# ---------------------------------------------------------------------------

# Servidor HTTP (Hono)
PORT=3000
# URL pública de la app (para enlaces de verificación/invitación en emails).
APP_URL=http://localhost:3000

# Supabase Storage (fotos, CVs, miniaturas).
# Project Settings → API: "Project URL" y la clave "service_role" (secreta,
# SOLO backend, nunca en el frontend).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Bucket PÚBLICO de Storage donde se guardan las miniaturas (créalo en
# Storage → New bucket → marcar "Public bucket").
SUPABASE_STORAGE_BUCKET=media

# Email transaccional (Resend): verificación, invitaciones y recordatorios.
RESEND_API_KEY=<re_xxxxxxxxxxxxxxxx>
EMAIL_FROM=Xarxatec Activa <no-reply@tu-dominio.com>
